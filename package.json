{
  "name": "portfolio",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "node -r dotenv/config mynode.js && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
